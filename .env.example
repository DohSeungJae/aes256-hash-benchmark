# 이 파일을 .env로 복사해서 쓰세요 (.env는 .gitignore에 있어 커밋되지 않습니다).
#   cp .env.example .env

DB_PASSWORD=change-me

# 개발용 기본값
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_SHM_SIZE=1g

# 본 측정용 (RAM 20GB 기준, 모든 구성에서 동일하게) — 계획서 5장
# PG_SHARED_BUFFERS=4GB
# PG_EFFECTIVE_CACHE_SIZE=12GB
# PG_SHM_SIZE=6g

# 앱 암호화 키 — 서버와 생성기가 반드시 같은 값을 써야 한다 (계획서 11장 "키 관리")
AES_ENCRYPTION_KEY=change-me-aes-key
HMAC_SECRET_KEY=change-me-hmac-key

# AES 키 유도 알고리즘: sha256(기본) | sha512
# 서버 내장 생성기와 generator/ 독립 생성기 모두 sha256으로 만든다.
# sha512는 jasypt AES256TextEncryptor로 만든 외부 데이터를 읽을 때만 쓴다.
AES_ALGORITHM=sha256

# HikariCP 풀 크기 (계획서 5장: 모든 구성에서 고정)
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=10
